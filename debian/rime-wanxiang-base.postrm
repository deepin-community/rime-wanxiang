#!/bin/sh
set -e

#DEBHELPER#

RIME_DATA_DIR="/usr/share/rime-data"
PACKAGE_NAME="rime-wanxiang-base"

case "$1" in
    remove|purge)
        # 1. 必须先删掉我们自己的 default.yaml 
        if [ -f "$RIME_DATA_DIR/default.yaml" ] || [ -L "$RIME_DATA_DIR/default.yaml" ]; then
            rm -f "$RIME_DATA_DIR/default.yaml"
        fi

        # 2. 安全移除 diversion 规则，并让系统自动把 .dist 还原回来
        # dpkg-divert 本身是非常安全的，不需要额外的 trap 或 temp 目录
        dpkg-divert --package "$PACKAGE_NAME" --remove --rename \
            --divert "$RIME_DATA_DIR/default.yaml.dist" "$RIME_DATA_DIR/default.yaml"
        ;;
        
    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        # 升级相关操作不需要处理转移规则，保持默认放行即可
        ;;
esac

exit 0
